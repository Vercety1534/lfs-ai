#!/usr/bin/env bash
# LFS-AI - LFS Optional Install Script
# Purpose: Install cmake & fastfetch
# Safe rerun: Yes
# Copyright (c) 2026 Michael Femiak (Vercety1534)
# SPDX-License-Identifier: MIT

set -euo pipefail

umask 022

RED=$'\033[31m'
GREEN=$'\033[32m'
BLUE=$'\033[34m'
MAGENTA=$'\033[35m'
RESET=$'\033[0m'

HEADER=$'\033[1;34m'
SUBHEADER=$'\033[1;35m'

LOG_DIR="/var/log/lfs-ai/optional"


# Error handling
die() {
    [ -t 1 ] && printf '\n'
    printf '%sERROR:%s %s\n' "$RED" "$RESET" "$1" >&2
    exit 1
}


cd /lfs-ai || die 'Missing /lfs-ai'


save_output_area() {
    if [ -t 1 ]; then
        printf '\033[s'
    fi
}


clear_output_area() {
    if [ -t 1 ]; then
        printf '\033[u\033[J'
    else
        printf '\n'
    fi
}


progress_bar() {
    local current="$1"
    local total="$2"
    local width=30
    local filled
    local empty
    local percent

    percent=$((current * 100 / total))
    filled=$((current * width / total))
    empty=$((width - filled))

    printf '['
    printf '%*s' "$filled" '' | tr ' ' '#'
    printf '%*s' "$empty" '' | tr ' ' '-'
    printf '] %s%%' "$percent"
}


rm -rf "$LOG_DIR"
mkdir -p "$LOG_DIR"

[ -d /lfs-ai/optional ] || die 'Missing /lfs-ai/optional'

require_var() {
    [ -n "${!1:-}" ] || die "Required variable $1 is not set."
}

require_var MAKE_JOBS

export MAKEFLAGS="${MAKEFLAGS:-$MAKE_JOBS}"
export TESTSUITEFLAGS="${TESTSUITEFLAGS:-$MAKE_JOBS}"

# Optional package install
shopt -s nullglob

scripts=()
for script in /lfs-ai/optional/*; do
    if [[ -f "$script" && -x "$script" ]]; then
        scripts+=("$script")
    fi
done

total_scripts="${#scripts[@]}"

if (( total_scripts == 0 )); then
    die 'No executable scripts found in /lfs-ai/optional'
fi

printf '%sRunning optional package scripts...%s\n' "$MAGENTA" "$RESET"
printf '\n'

save_output_area

current=0
for script in "${scripts[@]}"; do
    current=$((current + 1))
    name="$(basename "$script")"

    clear_output_area

    printf '%sRunning:%s  %s\n' "$BLUE" "$RESET" "$name"
    printf '%sProgress:%s %s/%s ' "$BLUE" "$RESET" "$current" "$total_scripts"
    progress_bar "$current" "$total_scripts"
    printf '\n\n'

    if bash "$script"; then
        printf '\n%sCompleted:%s %s\n' "$GREEN" "$RESET" "$name"
        sleep 1
    else
        printf '\n%sERROR:%s Optional script failed: %s\n' "$RED" "$RESET" "$name" >&2
        die "Optional package stage failed."
    fi
done

clear_output_area

printf '%sOptional packages complete!%s\n' "$GREEN" "$RESET"
printf '%sScripts completed:%s %s/%s\n' "$BLUE" "$RESET" "$total_scripts" "$total_scripts"
