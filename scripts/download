#!/usr/bin/env bash
# LFS-AI - Download Script
# Purpose: Download the required source packages
# Safe rerun: Yes
# Copyright (c) 2026 Michael Femiak (Vercety1534)
# SPDX-License-Identifier: MIT

set -euo pipefail

umask 022

RED=$'\033[31m'
GREEN=$'\033[32m'
BLUE=$'\033[34m'
MAGENTA=$'\033[35m'
RESET=$'\033[0m'

HEADER=$'\033[1;34m'
SUBHEADER=$'\033[1;35m'

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
base_dir="$(cd -- "$script_dir/.." && pwd)"

MAX_RETRIES=3
RETRY_DELAY=5


# Error handling
die() {
    [ -t 1 ] && printf '\n'
    printf '%sERROR:%s %s\n' "$RED" "$RESET" "$1" >&2
    exit 1
}


status_line() {
    local message="$1"

    if [ -t 1 ]; then
        printf '\r\033[K%s' "$message"
    else
        printf '%s\n' "$message"
    fi
}


status_done() {
    if [ -t 1 ]; then
        printf '\n'
    fi
}


# Required inputs
require_var() {
    [ -n "${!1:-}" ] || die "Required variable $1 is not set."
}

for var in LFS; do
    require_var "$var"
done


# Runtime prerequisites
[ -f "$base_dir/lists/wget-list" ] || die "Missing download list: $base_dir/lists/wget-list"
[ -f "$base_dir/lists/sha256sums" ] || die "Missing checksum file: $base_dir/lists/sha256sums"
[ -d "$LFS/sources" ] || die "Missing sources directory: $LFS/sources"
LOG_DIR="$LFS/var/log/lfs-ai"
LOG_FILE="$LOG_DIR/download.log"
FAILED_LIST="$LOG_DIR/download-failures.log"

command -v wget >/dev/null 2>&1 || die "wget is required but was not found."
command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required but was not found."
command -v awk >/dev/null 2>&1 || die "awk is required but was not found."
command -v sed >/dev/null 2>&1 || die "sed is required but was not found."


# Archive Check
has_checksum_entry() {
    local filename="$1"

    awk -v file="$filename" '
        {
            line = $0
            sub(/^[0-9a-fA-F]+[[:space:]]+\*?/, "", line)
            if (line == file) {
                found = 1
                exit
            }
        }
        END { exit(found ? 0 : 1) }
    ' "$base_dir/lists/sha256sums"
}


checksum_file() {
    local filename="$1"

    (
        cd "$LFS/sources" || exit 1
        awk -v file="$filename" '
            {
                line = $0
                sub(/^[0-9a-fA-F]+[[:space:]]+\*?/, "", line)
                if (line == file) {
                    print
                    exit
                }
            }
        ' "$base_dir/lists/sha256sums" | sha256sum -c - >/dev/null 2>&1
    )
}


get_filename_from_url() {
    local url="$1"
    printf '%s\n' "${url##*/}"
}


wget_impl() {
    local line
    line="$(wget --version 2>&1 | head -n1 || true)"

    case "$line" in
        *"GNU Wget"*) printf 'gnu\n' ;;
        *"BusyBox"*)  printf 'busybox\n' ;;
        *)
            if wget --help 2>&1 | grep -qi 'BusyBox'; then
                printf 'busybox\n'
            else
                printf 'unknown\n'
            fi
            ;;
    esac
}


download_with_wget() {
    local url="$1"

    case "$WGET_IMPL" in
        gnu)
            wget --continue                        \
                 --directory-prefix="$LFS/sources" \
                 --tries=1                         \
                 --timeout=45                      \
                 --dns-timeout=30                  \
                 --connect-timeout=30              \
                 --read-timeout=45                 \
                 --retry-connrefused               \
                 "$url"
            ;;
        busybox|unknown)
            wget -c                \
                 -P "$LFS/sources" \
                 -T 45             \
                 "$url"
            ;;
    esac
}


# Download packages
printf '\n%sStarting downloads...%s\n' "$MAGENTA" "$RESET"
: > "$LOG_FILE"
printf 'Download started: %s\n' "$(date '+%F %T')" >> "$LOG_FILE"

# wget progress output is not fully consistent across distro versions/builds.
# For example, Fedora may be more verbose than Ubuntu or Arch.
download_failed=0
: > "$FAILED_LIST"

WGET_IMPL="$(wget_impl)"

while IFS= read -r url || [ -n "$url" ]; do
    case "$url" in
        ''|\#*) continue ;;
    esac

    filename="$(get_filename_from_url "$url")"

    status_line "${MAGENTA}Checking:${RESET} $filename"

    if [ -f "$LFS/sources/$filename" ]; then
        if has_checksum_entry "$filename"; then
            if checksum_file "$filename"; then
                status_line "${GREEN}Verified existing:${RESET} $filename"
                printf 'SKIPPED verified existing file %s at %s\n' \
                    "$filename" "$(date '+%F %T')" >> "$LOG_FILE"
                continue
            else
                status_done
                printf '%sERROR:%s Existing file failed checksum, removing: %s\n' \
                    "$RED" "$RESET" "$filename"
                printf 'REMOVING bad existing file %s at %s\n' \
                    "$filename" "$(date '+%F %T')" >> "$LOG_FILE"
                rm -f "$LFS/sources/$filename"
            fi
        else
            status_line "${MAGENTA}Unmanaged existing:${RESET} $filename"
            printf 'SKIPPED unmanaged existing file %s at %s\n' \
                "$filename" "$(date '+%F %T')" >> "$LOG_FILE"
            continue
        fi
    fi

    count=0
    while [ "$count" -lt "$MAX_RETRIES" ]; do
        status_line "${MAGENTA}Downloading:${RESET} $filename  attempt $((count + 1))/$MAX_RETRIES"

        printf 'Attempt %s for %s at %s\n' \
            "$((count + 1))" "$url" "$(date '+%F %T')" >> "$LOG_FILE"

        if download_with_wget "$url" >> "$LOG_FILE" 2>&1; then
            status_line "${GREEN}Downloaded:${RESET} $filename"
            printf 'SUCCESS %s at %s\n' "$url" "$(date '+%F %T')" >> "$LOG_FILE"
            break
        fi

        count=$((count + 1))
        printf 'FAILED attempt %s for %s at %s\n' \
            "$count" "$url" "$(date '+%F %T')" >> "$LOG_FILE"

        if [ "$count" -lt "$MAX_RETRIES" ]; then
            status_line "${RED}Failed:${RESET} $filename — retrying in ${RETRY_DELAY}s"
            sleep "$RETRY_DELAY"
        else
            status_line "${RED}Failed:${RESET} $filename after $MAX_RETRIES attempts"
            printf 'ABORTED after %s attempts: %s\n' \
                "$MAX_RETRIES" "$url" >> "$LOG_FILE"
            printf '%s\n' "$url" >> "$FAILED_LIST"
            download_failed=1
            rm -f "$LFS/sources/$filename"
            break
        fi
    done
done < "$base_dir/lists/wget-list"

status_done

chown -R root:root "$LFS/sources" >/dev/null 2>&1
printf 'Download completed: %s\n' "$(date '+%F %T')" >> "$LOG_FILE"

if [ "$download_failed" -eq 0 ]; then
    printf '%sLogging to:%s %s\n' "$BLUE" "$RESET" "$LOG_FILE"
    printf '%sDownloads completed!%s\n\n' "$GREEN" "$RESET"
else
    die "One or more downloads failed. See $FAILED_LIST and $LOG_FILE"
fi

printf 'Checksum verification started: %s\n' "$(date '+%F %T')" >> "$LOG_FILE"
printf '%sVerifying source checksums...%s\n' "$MAGENTA" "$RESET"
cd "$LFS/sources"

# Two CAcerts are not verified due to being non-versioned.
# Hashes could change without notice, resulting in checksum failures.
checksum_failed=0

while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        ''|\#*) continue ;;
    esac

    checksum="${line%% *}"
    rest="${line#"$checksum"}"
    filename="$(printf '%s' "$rest" | sed 's/^[[:space:]]*//; s/^\*//')"

    [ -f "$filename" ] || die "Missing downloaded file: $filename"

    status_line "${MAGENTA}Verifying:${RESET} $filename"

    if printf '%s\n' "$line" | sha256sum -c - >> "$LOG_FILE" 2>&1; then
        status_line "${GREEN}Verified:${RESET} $filename"
        printf 'CHECKSUM OK %s at %s\n' "$filename" "$(date '+%F %T')" >> "$LOG_FILE"
    else
        status_done
        printf '%sERROR:%s Checksum failed: %s\n' "$RED" "$RESET" "$filename" >&2
        printf 'CHECKSUM FAILED %s at %s\n' "$filename" "$(date '+%F %T')" >> "$LOG_FILE"
        checksum_failed=1
    fi
done < "$base_dir/lists/sha256sums"

status_done

if [ "$checksum_failed" -eq 0 ]; then
    printf '%sDownload and checksum verification successful!%s\n\n' "$GREEN" "$RESET"
    printf 'Checksum verification successful: %s\n' "$(date '+%F %T')" >> "$LOG_FILE"
else
    die "One or more checksum verifications failed. See $LOG_FILE"
fi
